# Invoxa environment template.
# Copy to .env for local development. Never commit .env or real secrets.
# Generate each 32-byte key with: openssl rand -base64 32
# Windows/Node alternative: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
BIND_ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://invoxa:invoxa_dev_password@localhost:55432/invoxa
DATABASE_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------
# Private object storage (local disk adapter)
# ---------------------------------------------------------------------------
STORAGE_ROOT=.local/storage
STORAGE_MAX_FILE_BYTES=20971520
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PAGES=50
UPLOAD_MAX_IMAGE_PIXELS=25000000
UPLOAD_MAX_BATCH=20

# ---------------------------------------------------------------------------
# Sessions and browser security
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
TRUST_PROXY=false
AUTH_RATE_LIMIT_PER_MINUTE=30
API_KEY_RATE_LIMIT_PER_MINUTE=120

# Required. Base64-encoded 32-byte keys. Generate independent values.
ENCRYPTION_KEY=replace-with-base64-32-bytes
CSRF_SECRET=replace-with-base64-32-bytes
# Optional. If omitted, a download key is derived from ENCRYPTION_KEY.
DOWNLOAD_SIGNING_KEY=

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# Windows example: "C:/Program Files/Tesseract-OCR/tesseract.exe"
# Linux/Docker example: /usr/bin/tesseract
TESSERACT_PATH=
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
OCR_PAGE_SEGMENTATION_MODE=6

# ---------------------------------------------------------------------------
# Extraction provider
# ---------------------------------------------------------------------------
# mock = deterministic labels for local testing, always labelled is_mock=true.
# openai = any OpenAI-compatible structured-output endpoint.
AI_PROVIDER=mock
ALLOW_MOCK_AI=true

# Required only when AI_PROVIDER=openai:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=
# AI_STRUCTURED_OUTPUT=json_schema
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2
# AI_MAX_INPUT_CHARS=60000
# AI_ORGANIZATION=
# AI_CIRCUIT_FAILURES=5
# AI_CIRCUIT_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Development and webhooks
# ---------------------------------------------------------------------------
EXPOSE_DEV_TOKENS=true
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_HTTP_PORTS=
WEBHOOK_VALIDATION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_CONCURRENCY=2
