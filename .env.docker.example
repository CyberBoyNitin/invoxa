# Copy to .env.docker and replace every placeholder.
# Generate keys with:
#   openssl rand -base64 32
# or on Windows:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ENCRYPTION_KEY=replace-with-base64-32-bytes
CSRF_SECRET=replace-with-a-different-base64-32-bytes
DOWNLOAD_SIGNING_KEY=

APP_ENV=development
APP_URL=http://localhost:3000
COOKIE_SECURE=false
API_PORT=8080
WEB_PORT=3000
DATABASE_MAX_CONNECTIONS=20

# mock is safe for local evaluation. It is deterministic and always labelled.
AI_PROVIDER=mock
ALLOW_MOCK_AI=true
OCR_LANGUAGE=eng
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_CONCURRENCY=2

# External AI (optional; only used when AI_PROVIDER=openai):
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_API_KEY=
